---
import { SOCIAL_LINKS } from '../consts';

const currentYear = new Date().getFullYear();
const socials = [
  { name: 'Instagram', href: SOCIAL_LINKS.instagram },
  { name: 'Strava', href: SOCIAL_LINKS.strava },
  { name: 'Facebook', href: SOCIAL_LINKS.facebook },
  { name: 'TikTok', href: SOCIAL_LINKS.tiktok },
];
---

<footer class="w-full border-t border-white/10 bg-zinc-950 py-12 text-zinc-500">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Info del Club -->
      <div>
        <h3 class="text-white font-bold mb-4">Alpha Running Club</h3>
        <p class="text-sm leading-relaxed">
          Los Mustangs de Copán. Corriendo con propósito en Santa Rosa de Copán. <br/>
          Impulsado por la tecnología y la comunidad.
        </p>
      </div>

      <!-- Links rápidos -->
      <div class="flex flex-col gap-2 text-sm">
        <h3 class="text-white font-bold mb-2">Navegación</h3>
        <a href="/zonas-desempeno" class="hover:text-green-500 transition-colors">Zonas & Desempeño</a>
        <a href="/#club" class="hover:text-green-500 transition-colors">Sobre el Club</a>
        <a href="/#eventos" class="hover:text-green-500 transition-colors">Eventos & Rutas</a>
      </div>

      <!-- Redes Sociales -->
      <div>
        <h3 class="text-white font-bold mb-4">Síguenos</h3>
        <div class="flex flex-wrap gap-4 text-sm">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" class="hover:text-green-500 transition-colors">{s.name}</a>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-white/5 text-center text-xs">
      <p>&copy; {currentYear} Alpha Running Club. Creado por
        <a href="https://coderhn.dev" target="_blank" rel="noopener noreferrer" class="text-green-500 hover:underline">CoderHN</a>.
      </p>
    </div>
  </div>
</footer>
